{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "ASK",
        "CONTINUE",
        "COMPLETE",
        "HANDOFF",
        "EXPLAIN_LAW",
        "NO_ACTION"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "speech": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4000
    },
    "pending_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "decision",
    "target",
    "speech",
    "pending_points"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ASK"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "CONTINUE",
              "HANDOFF"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pending_points": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "NO_ACTION"
          }
        }
      },
      "then": {
        "properties": {
          "speech": {
            "const": ""
          },
          "pending_points": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "speech": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JudgeV2-agent-output"
}
