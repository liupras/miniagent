{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "case_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "case_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "court_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "procedure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "cause_of_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "subject_matter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "is_simulated": {
          "type": "boolean"
        },
        "legal_effect_disclaimer": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        }
      },
      "required": [
        "case_id",
        "case_number",
        "court_name",
        "procedure",
        "cause_of_action",
        "subject_matter",
        "is_simulated",
        "legal_effect_disclaimer"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "role": {
            "enum": [
              "judge",
              "clerk",
              "plaintiff",
              "defendant",
              "system"
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512
          }
        },
        "required": [
          "participant_id",
          "role",
          "display_name",
          "description"
        ]
      },
      "maxItems": 32
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "stage_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "step_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "segment_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "role": {
            "enum": [
              "judge",
              "clerk",
              "plaintiff",
              "defendant",
              "system"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "\\S"
          },
          "is_intervention": {
            "type": "boolean"
          }
        },
        "required": [
          "sequence",
          "stage_name",
          "step_name",
          "segment_name",
          "role",
          "text",
          "is_intervention"
        ]
      },
      "maxItems": 512
    }
  },
  "required": [
    "state_version",
    "case_info",
    "participants",
    "records"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virtual-court:transcript-v3:transcript-request:2026-11-04-transcript-v3-configured-names"
}
