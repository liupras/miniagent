{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "decision": {
      "enum": [
        "ASK",
        "COMPLETE",
        "HANDOFF"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "speech": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "pending_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "state_version",
    "decision",
    "target",
    "speech",
    "pending_points"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ASK"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "HANDOFF"
          }
        }
      },
      "then": {
        "properties": {
          "pending_points": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virtual-court:judge-v2:next-action-response:2026-09-13-split-endpoints",
  "title": "JudgeV2-next-action-response"
}
