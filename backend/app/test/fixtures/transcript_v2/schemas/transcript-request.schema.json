{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "case_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "pattern": "\\S"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 30
        },
        "defenses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 30
        },
        "dispute_focuses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "summary",
        "claims",
        "defenses",
        "dispute_focuses"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "SPEECH",
              "SUMMARY"
            ]
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "pattern": "\\S"
          }
        },
        "required": [
          "type",
          "role",
          "text"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "SPEECH"
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "\\S"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000,
                  "pattern": "\\S"
                }
              }
            },
            "else": {
              "properties": {
                "role": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 512
    }
  },
  "required": [
    "state_version",
    "case_context",
    "records"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virtual-court:transcript-v2:transcript-request:2026-09-17-transcript-v2",
  "title": "TranscriptV2-transcript-request"
}
